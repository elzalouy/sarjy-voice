# Copy this file to .env and fill in every empty value.
# Do not commit .env. Startup lists missing names and does not print secret values.

LIVEKIT_URL=wss
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
OPENAI_API_KEY=
NEXTJS_API_BASE_URL=http://127.0.0.1:3000
AGENT_SERVICE_TOKEN=

# Speech defaults. Override these to compare a model, locale, or voice.
# TTS_VOICE_ID is an ElevenLabs voice that can speak Saudi Arabic.
STT_MODEL=nova-3
STT_LOCALE=ar-SA
TTS_PROVIDER=elevenlabs
TTS_MODEL=eleven_flash_v2_5
TTS_VOICE_ID=
TTS_LOCALE=ar-SA
TTS_TEXT_NORMALIZATION=off
